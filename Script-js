  const result =
    document.getElementById("adResult");


  if (!product.trim()) {

    result.innerHTML =
      "⚠️ Please enter your product or service first.";

    return;
  }


  result.innerHTML =
    "📢 Creating your advertisement...";


  setTimeout(() => {

    const ad = `
🎬 AI ADVERTISEMENT

Product / Service:
${product}

Target Audience:
${audience}

Platform:
${platform}

Duration:
${duration}

Style:
${style}


🔥 HOOK

Looking for a better way to ${product}?

Discover a solution designed to make things easier, faster and better.


✨ MAIN MESSAGE

Meet ${product}.

Created for ${audience}, this solution combines simplicity, value and convenience in one powerful experience.


🚀 CALL TO ACTION

Don't wait.

Try ${product} today and see the difference for yourself.


📢 AD ENDING

${product} — Make your next move smarter.
`;


    result.innerHTML = `
      <strong>✨ Your AI Advertisement</strong><br><br>
      ${ad.replace(/\n/g, "<br>")}
    `;


    // Save project
    saveRecentProject(
      "📢 Advertisement",
      product
    );


  }, 1000);
}


// ===============================
// DEMO LOGIN SYSTEM
// ===============================

document.addEventListener("DOMContentLoaded", function () {

  const loginSection =
    document.getElementById("login");

  const dashboard =
    document.getElementById("tools");


  if (!loginSection) return;


  const inputs =
    loginSection.querySelectorAll("input");

  const loginButton =
    loginSection.querySelector("button");

  const createAccount =
    loginSection.querySelector("span");


  if (!inputs.length || !loginButton) return;


  const emailInput = inputs[0];

  const passwordInput = inputs[1];


  // ===============================
  // DASHBOARD WELCOME
  // ===============================

  function showDashboardWelcome() {

    const savedEmail =
      localStorage.getItem("aiCreatorUser");


    if (!savedEmail || !dashboard) return;


    const dashboardTitle =
      dashboard.querySelector("h2");


    if (!dashboardTitle) return;


    let welcome =
      document.getElementById("userWelcome");


    if (!welcome) {

      welcome =
        document.createElement("p");

      welcome.id =
        "userWelcome";

      welcome.style.color =
        "#38bdf8";

      welcome.style.fontSize =
        "16px";

      welcome.style.marginTop =
        "10px";


      dashboardTitle.parentElement.insertBefore(
        welcome,
        dashboardTitle.nextSibling
      );
    }


    welcome.innerHTML =
      "👋 Welcome back, <strong>" +
      savedEmail +
      "</strong>";
  }


  // ===============================
  // CHECK EXISTING LOGIN
  // ===============================

  const savedEmail =
    localStorage.getItem("aiCreatorUser");


  if (savedEmail) {

    loginButton.textContent =
      "✓ Logged In";

    loginButton.style.background =
      "#22c55e";


    let message =
      document.getElementById("loginMessage");


    if (!message) {

      message =
        document.createElement("p");

      message.id =
        "loginMessage";

      message.style.color =
        "#22c55e";

      message.style.textAlign =
        "center";

      message.style.marginTop =
        "15px";


      loginButton.parentElement.appendChild(
        message
      );
    }


    message.innerHTML =
      "✓ Welcome back, " +
      savedEmail;


    showDashboardWelcome();
  }


  // ===============================
  // SIGN IN
  // ===============================

  loginButton.addEventListener(
    "click",
    function () {

      const email =
        emailInput.value.trim();

      const password =
        passwordInput.value.trim();


      if (!email || !password) {

        alert(
          "Please enter your email and password."
        );

        return;
      }


      if (!email.includes("@")) {

        alert(
          "Please enter a valid email address."
        );

        return;
      }


      localStorage.setItem(
        "aiCreatorUser",
        email
      );


      loginButton.textContent =
        "✓ Logged In";

      loginButton.style.background =
        "#22c55e";


      let message =
        document.getElementById("loginMessage");


      if (!message) {

        message =
          document.createElement("p");

        message.id =
          "loginMessage";

        message.style.color =
          "#22c55e";

        message.style.textAlign =
          "center";

        message.style.marginTop =
          "15px";


        loginButton.parentElement.appendChild(
          message
        );
      }


      message.innerHTML =
        "✓ Welcome, " +
        email;


      passwordInput.value = "";


      showDashboardWelcome();
    }
  );


  // ===============================
  // CREATE ACCOUNT
  // ===============================

  if (createAccount) {

    createAccount.addEventListener(
      "click",
      function () {

        const email =
          emailInput.value.trim();


        if (!email) {

          alert(
            "Enter your email first to create an account."
          );

          return;
        }


        localStorage.setItem(
          "aiCreatorUser",
          email
        );


        alert(
          "🎉 Demo account created successfully!"
        );


        loginButton.textContent =
          "✓ Logged In";


        loginButton.style.background =
          "#22c55e";


        showDashboardWelcome();
      }
    );
  }


  // ===============================
  // LOGOUT BUTTON
  // ===============================

  function addLogoutButton() {

    if (
      document.getElementById("logoutButton")
    ) return;


    const logoutButton =
      document.createElement("button");


    logoutButton.id =
      "logoutButton";


    logoutButton.textContent =
      "Log Out";


    logoutButton.style.width =
      "100%";

    logoutButton.style.padding =
      "14px";

    logoutButton.style.marginTop =
      "12px";

    logoutButton.style.background =
      "#ef4444";

    logoutButton.style.color =
      "white";

    logoutButton.style.border =
      "0";

    logoutButton.style.borderRadius =
      "10px";

    logoutButton.style.fontSize =
      "16px";

    logoutButton.style.fontWeight =
      "bold";

    logoutButton.style.cursor =
      "pointer";


    logoutButton.addEventListener(
      "click",
      function () {

        localStorage.removeItem(
          "aiCreatorUser"
        );

        location.reload();
      }
    );


    loginButton.parentElement.appendChild(
      logoutButton
    );
  }


  if (
    localStorage.getItem("aiCreatorUser")
  ) {

    addLogoutButton();
  }


  loginButton.addEventListener(
    "click",
    function () {

      setTimeout(function () {

        if (
          localStorage.getItem("aiCreatorUser")
        ) {

          addLogoutButton();
        }

      }, 100);

    }
  );


  // ===============================
  // LOAD RECENT PROJECTS
  // ===============================

  renderRecentProjects();

});
// ===============================
// DYNAMIC CREDITS SYSTEM
// ===============================

function getCredits() {
  let credits = localStorage.getItem("aiCreatorCredits");

  if (credits === null) {
    credits = 25;
    localStorage.setItem("aiCreatorCredits", credits);
  }

  return Number(credits);
}


// ===============================
// UPDATE CREDIT DISPLAY
// ===============================

function updateCreditsDisplay() {

  const credits = getCredits();

  const dashboard =
    document.getElementById("tools");

  if (!dashboard) return;

  const elements =
    dashboard.querySelectorAll("*");

  elements.forEach(function(element) {

    if (
      element.children.length === 0 &&
      element.textContent.includes("Credits")
    ) {
      element.textContent =
        "⚡ " + credits + " Credits";
    }

  });

  elements.forEach(function(element) {

    if (
      element.children.length === 0 &&
      element.textContent.includes("% of your monthly credits used")
    ) {

      const used = 25 - credits;
      const percentage = Math.round((used / 25) * 100);

      element.textContent =
        percentage + "% of your monthly credits used";
    }

  });
}


// ===============================
// USE ONE CREDIT
// ===============================

function useCredit() {

  let credits = getCredits();

  if (credits <= 0) {

    alert(
      "⚠️ You have no credits left. Please upgrade your plan."
    );

    return false;
  }

  credits--;

  localStorage.setItem(
    "aiCreatorCredits",
    credits
  );

  updateCreditsDisplay();

  return true;
}


// ===============================
// CHECK BEFORE SCRIPT GENERATION
// ===============================

const originalGenerateScript =
  window.generateScript;

window.generateScript = function() {

  const topic =
    document.getElementById("topic")?.value || "";

  if (!topic.trim()) {
    originalGenerateScript();
    return;
  }

  if (!useCredit()) return;

  originalGenerateScript();
};


// ===============================
// CHECK BEFORE AD GENERATION
// ===============================

const originalGenerateAd =
  window.generateAd;

window.generateAd = function() {

  const product =
    document.getElementById("adProduct")?.value || "";

  if (!product.trim()) {
    originalGenerateAd();
    return;
  }

  if (!useCredit()) return;

  originalGenerateAd();
};


// ===============================
// LOAD CREDITS
// ===============================

document.addEventListener(
  "DOMContentLoaded",
  function() {

    updateCreditsDisplay();

  }
);
