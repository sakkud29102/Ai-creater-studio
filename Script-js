// ===============================
// RECENT PROJECTS SYSTEM
// ===============================

function saveRecentProject(type, title) {

  let projects =
    JSON.parse(localStorage.getItem("aiCreatorProjects")) || [];

  const newProject = {
    type: type,
    title: title,
    date: new Date().toLocaleString()
  };

  projects.unshift(newProject);

  // Sirf latest 5 projects rakho
  projects = projects.slice(0, 5);

  localStorage.setItem(
    "aiCreatorProjects",
    JSON.stringify(projects)
  );

  renderRecentProjects();
}


// ===============================
// RENDER RECENT PROJECTS
// ===============================

function renderRecentProjects() {

  const dashboard = document.getElementById("tools");

  if (!dashboard) return;

  const allElements = dashboard.querySelectorAll("*");

  let heading = null;
  let emptyText = null;

  allElements.forEach(function (element) {

    const text = element.textContent.trim();

    if (text === "🕘 Recent Projects") {
      heading = element;
    }

    if (text === "Your latest creations will appear here.") {
      emptyText = element;
    }
  });

  if (!heading) return;

  const parent = heading.parentElement;

  if (!parent) return;


  // Hide old static project items
  allElements.forEach(function (element) {

    const text = element.textContent.trim();

    if (
      text === "🎬 YouTube Script" ||
      text === "📢 Advertisement"
    ) {
      element.style.display = "none";
    }

  });


  // Hide old empty message
  if (emptyText) {
    emptyText.style.display = "none";
  }


  // Create projects container
  let projectList =
    document.getElementById("recentProjectsList");

  if (!projectList) {

    projectList = document.createElement("div");

    projectList.id = "recentProjectsList";

    projectList.style.marginTop = "15px";

    parent.appendChild(projectList);
  }


  const projects =
    JSON.parse(localStorage.getItem("aiCreatorProjects")) || [];


  if (projects.length === 0) {

    projectList.innerHTML = `
      <div style="
        padding:15px;
        border-radius:12px;
        background:rgba(255,255,255,0.04);
        color:#94a3b8;
      ">
        Your latest creations will appear here.
      </div>
    `;

    return;
  }


  projectList.innerHTML = projects.map(function (project) {

    return `
      <div style="
        padding:15px;
        margin-bottom:10px;
        border-radius:12px;
        background:rgba(255,255,255,0.05);
        border:1px solid rgba(255,255,255,0.08);
      ">

        <div style="
          font-weight:bold;
          color:#ffffff;
          margin-bottom:6px;
        ">
          ${escapeHTML(project.type)}
        </div>

        <div style="
          color:#cbd5e1;
          font-size:14px;
          margin-bottom:6px;
        ">
          ${escapeHTML(project.title)}
        </div>

        <div style="
          color:#64748b;
          font-size:12px;
        ">
          ${escapeHTML(project.date)}
        </div>

      </div>
    `;

  }).join("");
}


// ===============================
// SAFE TEXT
// ===============================

function escapeHTML(text) {

  const div = document.createElement("div");

  div.textContent = text;

  return div.innerHTML;
}


// ===============================
// AI SCRIPT GENERATOR
// ===============================

async function generateScript() {

  const topic =
    document.getElementById("topic").value;

  const videoType =
    document.getElementById("videoType").value;

  const language =
    document.getElementById("language").value;

  const style =
    document.getElementById("style").value;

  const result =
    document.getElementById("result");


  if (!topic.trim()) {

    result.innerHTML =
      "⚠️ Please enter a video topic first.";

    return;
  }


  result.innerHTML =
    "🤖 Creating your script...";


  setTimeout(() => {

    let intro = "";


    if (language === "Urdu") {

      intro = `Aaj hum baat karenge "${topic}" ke baare mein.

Ye topic pehli nazar mein simple lag sakta hai, lekin iske peeche ek interesting story chhupi hui hai.

Sab se pehle samajhte hain ke asal mein hota kya hai...`;

    }


    else if (language === "Hindi") {

      intro = `Aaj hum baat karenge "${topic}" ke baare mein.

Ye topic pehli nazar mein simple lag sakta hai, lekin iske peeche ek interesting story chhupi hui hai.

Sabse pehle samajhte hain ki asal mein hota kya hai...`;

    }


    else if (language === "Arabic") {

      intro = `اليوم سنتحدث عن "${topic}".

قد يبدو هذا الموضوع بسيطًا، لكن وراءه قصة مثيرة للاهتمام.

لنبدأ بفهم ما يحدث بالفعل...`;

    }


    else {

      intro = `Today, we're looking at "${topic}".

At first glance, this topic may seem simple. But behind it is a much more interesting story.

So let's start by understanding what is really happening...`;

    }


    const script = `
🎬 ${videoType} Script

Topic: ${topic}
Style: ${style}
Language: ${language}

${intro}

The deeper we look, the more surprising the story becomes.

There is a reason this matters, and once you understand the mechanism behind it, the whole picture starts to make sense.

So stay with the story, because the most interesting part is still ahead.

[AI Creator Studio Demo Mode]
`;


    result.innerHTML = `
      <strong>✨ Your AI Script</strong><br><br>
      ${script.replace(/\n/g, "<br>")}
    `;


    // Save project
    saveRecentProject(
      "🎬 YouTube Script",
      topic
    );


  }, 1000);
}


