async function generateScript() {
  const topic = document.getElementById("topic").value;
  const videoType = document.getElementById("videoType").value;
  const language = document.getElementById("language").value;
  const style = document.getElementById("style").value;
  const result = document.getElementById("result");

  if (!topic.trim()) {
    result.innerHTML = "⚠️ Please enter a video topic first.";
    return;
  }

  result.innerHTML = "🤖 Creating your script...";

  // Demo Mode - works without API credits
  setTimeout(() => {

    let intro = "";

    if (language === "Urdu") {
      intro = `Aaj hum baat karenge "${topic}" ke baare mein.

Ye topic pehli nazar mein simple lag sakta hai, lekin iske peeche ek interesting story chhupi hui hai.

Sab se pehle samajhte hain ke asal mein hota kya hai...`;
    } else if (language === "Hindi") {
      intro = `Aaj hum baat karenge "${topic}" ke baare mein.

Ye topic pehli nazar mein simple lag sakta hai, lekin iske peeche ek interesting story chhupi hui hai.

Sabse pehle samajhte hain ki asal mein hota kya hai...`;
    } else if (language === "Arabic") {
      intro = `اليوم سنتحدث عن "${topic}".

قد يبدو هذا الموضوع بسيطًا، لكن وراءه قصة مثيرة للاهتمام.

لنبدأ بفهم ما يحدث بالفعل...`;
    } else {
      intro = `Today, we're looking at "${topic}".

At first glance, this topic may seem simple. But behind it is a much more interesting story.

So let's start by understanding what is really happening...`;
    }

    const script = `
🎬 ${videoType} Script

Topic: ${topic}
Style: ${style}
Language: ${language}

${intro}

The deeper we look, the more surprising the story becomes.

There is a reason this matters, and once you understand the mechanism behind it, the whole picture starts to make sense.

So stay with the story, because the most interesting part is still ahead.

[Demo Mode]
This script was generated by AI Creator Studio's demo system.

Real AI generation will be connected when API credits are available.
`;

    result.innerHTML = `
      <strong>✨ Your AI Script</strong><br><br>
      ${script.replace(/\n/g, "<br>")}
    `;

  }, 1000);
}


function generateAd() {
  const product = document.getElementById("adProduct").value;
  const audience = document.getElementById("adAudience").value;
  const platform = document.getElementById("adPlatform").value;
  const duration = document.getElementById("adDuration").value;
  const style = document.getElementById("adStyle").value;
  const result = document.getElementById("adResult");

  if (!product.trim()) {
    result.innerHTML = "⚠️ Please enter your product or service first.";
    return;
  }

  result.innerHTML = `
    <strong>📢 Advertisement Request Created</strong><br><br>

    <strong>Product / Service:</strong> ${product}<br>
    <strong>Target Audience:</strong> ${audience}<br>
    <strong>Platform:</strong> ${platform}<br>
    <strong>Duration:</strong> ${duration}<br>
    <strong>Style:</strong> ${style}<br><br>

    🤖 Demo advertisement created successfully.
  `;
}
